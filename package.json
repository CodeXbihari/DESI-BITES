{
  "name": "desi-delivery-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --env-file-if-exists=.env --experimental-strip-types --test tests/*.test.mjs",
    "test:backend": "node --experimental-strip-types --test tests/backend/*.test.mjs",
    "test:emulator": "node scripts/run_backend_emulators.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/auth": "^27.1.0",
    "@react-native-firebase/firestore": "27.1.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.24",
    "expo-asset": "^58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.19",
    "expo-font": "~58.0.11",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "firebase": "13.1.0",
    "jpeg-js": "^0.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/react": "~19.3.0",
    "firebase-tools": "15.36.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@firebase/app": "0.16.4",
    "@firebase/app-compat": "0.5.20"
  }
}
